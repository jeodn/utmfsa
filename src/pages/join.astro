---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import { siteConfig } from "../config/site.config";

interface Role {
  title: string;
  department: string;
  type: string;
  description: string;
}

const execRoles: Role[] = [
  {
    title: "Marketing Associate",
    department: "Marketing & Media",
    type: "Associate Position",
    description: "Design social media graphics, capture event photography, and manage digital promotions."
  },
  {
    title: "Events Coordinator",
    department: "Events & Logistics",
    type: "Associate Position",
    description: "Assist with event setup, venue booking, catering coordination, and ticket management."
  },
  {
    title: "Corporate Relations Associate",
    department: "External Affairs",
    type: "Associate Position",
    description: "Reach out to local Mississauga vendors, pitch sponsorship packages, and expand VIP perks."
  },
  {
    title: "Finance & Ticketing Officer",
    department: "Finance",
    type: "Associate Position",
    description: "Track event budgets, manage ticket sales distribution, and assist with VIP card logistics."
  }
];
---

<Layout title="UTMFSA | Why Join FSA?" description="Discover why you should join UTMFSA — cultural community, flagship events, executive positions, and general member perks at UTM.">
  <!-- Page Banner Header -->
  <section class="py-16 sm:py-20 bg-bg-subtle border-b border-border-subtle text-center">
    <div class="container max-w-4xl">
      <span class="section-eyebrow">WHY JOIN UTMFSA?</span>
      <h1 class="text-4xl sm:text-6xl font-headline font-bold text-text-main tracking-tight mb-4">
        Your Home Away From Home at UTM
      </h1>
      <p class="text-text-muted text-lg sm:text-xl leading-relaxed max-w-2xl mx-auto">
        Whether you are seeking cultural connection, lifelong friendships, professional leadership opportunities, or exclusive local discounts, UTMFSA welcomes everyone!
      </p>
    </div>
  </section>

  <!-- What We Do: Core Pillars -->
  <section class="py-16 bg-bg-main border-b border-border-subtle">
    <div class="container">
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="section-eyebrow">OUR PILLARS</span>
        <h2 class="text-3xl sm:text-4xl font-headline font-bold text-text-main mb-4">
          What We Do
        </h2>
        <p class="text-text-muted text-base sm:text-lg">
          UTMFSA is dedicated to enhancing student life at UTM through four key community pillars.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 rounded-2xl border border-border-subtle bg-bg-card shadow-xs">
          <div class="h-12 w-12 rounded-xl bg-primary-light text-primary flex items-center justify-center mb-4">
            <Icon name="sparkles" size={24} />
          </div>
          <h3 class="font-headline font-bold text-lg text-text-main mb-2">Cultural Connection</h3>
          <p class="text-text-muted text-sm leading-relaxed">
            Celebrating Filipino heritage, traditional dance, food, music, and language through inclusive cultural events like Mabuhay Night.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-border-subtle bg-bg-card shadow-xs">
          <div class="h-12 w-12 rounded-xl bg-secondary-light text-secondary flex items-center justify-center mb-4">
            <Icon name="users" size={24} />
          </div>
          <h3 class="font-headline font-bold text-lg text-text-main mb-2">Social Community</h3>
          <p class="text-text-muted text-sm leading-relaxed">
            Hosting fun social hangouts, icebreaker games, Boba tea runs, study sessions, and our annual formal gala.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-border-subtle bg-bg-card shadow-xs">
          <div class="h-12 w-12 rounded-xl bg-gold-light text-text-main flex items-center justify-center mb-4">
            <Icon name="badge" size={24} />
          </div>
          <h3 class="font-headline font-bold text-lg text-text-main mb-2">Exclusive Perks</h3>
          <p class="text-text-muted text-sm leading-relaxed">
            Unlock year-round discounts at participating Mississauga restaurants, bubble tea shops, and entertainment spots.
          </p>
        </div>

        <div class="p-6 rounded-2xl border border-border-subtle bg-bg-card shadow-xs">
          <div class="h-12 w-12 rounded-xl bg-primary-light text-primary flex items-center justify-center mb-4">
            <Icon name="star" size={24} />
          </div>
          <h3 class="font-headline font-bold text-lg text-text-main mb-2">Leadership Growth</h3>
          <p class="text-text-muted text-sm leading-relaxed">
            Gain real-world experience in event planning, marketing, finance, corporate partnerships, and executive management.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- General Member Opportunity Section (Single Apply Button) -->
  <section class="py-16 bg-bg-subtle border-b border-border-subtle">
    <div class="container">
      <div class="max-w-4xl mx-auto rounded-3xl bg-bg-card border border-border-subtle p-8 sm:p-12 shadow-sm">
        <div class="flex flex-col md:flex-row items-center justify-between gap-8">
          <div>
            <span class="inline-block px-3 py-1 bg-primary-light text-primary text-xs font-bold uppercase tracking-widest rounded-full mb-3">
              GENERAL MEMBERSHIP
            </span>
            <h2 class="text-3xl font-headline font-bold text-text-main mb-3">
              Become a General Member Today
            </h2>
            <p class="text-text-muted text-base leading-relaxed mb-4">
              General membership is open to all UTM students! Receive your UTMFSA VIP membership card, enjoy discount perks, and get priority access to all events.
            </p>
            <div class="flex flex-wrap items-center gap-4 text-xs font-bold text-text-main">
              <span class="flex items-center gap-1.5"><Icon name="badge" size={16} class="text-primary" /> Instant VIP Card Discounts</span>
              <span class="flex items-center gap-1.5"><Icon name="sparkles" size={16} class="text-gold" /> Priority Event Access</span>
            </div>
          </div>
          <a 
            href={siteConfig.links.generalMemberForm} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="btn-primary text-base px-8 py-3.5 shadow-lg shrink-0"
          >
            <span>Sign Up as General Member</span>
            <Icon name="arrowRight" size={18} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Executive Positions & Roles Section (Small Tiles & Single Central Apply Button) -->
  <section class="py-16 bg-bg-main">
    <div class="container max-w-5xl">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="section-eyebrow">EXECUTIVE OPPORTUNITIES</span>
        <h2 class="text-3xl sm:text-4xl font-headline font-bold text-text-main mb-4">
          Open Executive & Associate Roles
        </h2>
        <p class="text-text-muted text-base sm:text-lg">
          Want to build your leadership portfolio and shape UTMFSA's future? Explore available committee positions and submit your application.
        </p>
      </div>

      <!-- Small Role Tiles Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-12">
        {execRoles.map((role) => (
          <div class="p-5 rounded-xl border border-border-subtle bg-bg-card shadow-xs flex flex-col justify-between hover:border-primary/30 transition-colors">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="px-2.5 py-0.5 rounded-full bg-primary-light text-primary text-[11px] font-bold">
                  {role.department}
                </span>
                <span class="text-[11px] text-text-muted font-semibold">
                  {role.type}
                </span>
              </div>
              <h3 class="text-base font-headline font-bold text-text-main mb-1">
                {role.title}
              </h3>
              <p class="text-text-muted text-xs leading-relaxed">
                {role.description}
              </p>
            </div>
          </div>
        ))}
      </div>

      <!-- Single Primary Executive Application Button -->
      <div class="text-center">
        <a 
          href={siteConfig.links.execApplicationForm} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="btn-primary text-base px-10 py-4 shadow-xl inline-flex items-center gap-3"
        >
          <span>Apply for Executive Roles</span>
          <Icon name="arrowRight" size={18} />
        </a>
      </div>
    </div>
  </section>
</Layout>
