---
import Layout from "../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

let eventPostsWithContent: any[] = [];
try {
  const collection = await getCollection("events");
  if (collection && collection.length > 0) {
    eventPostsWithContent = await Promise.all(
      collection.map(async (event) => {
        const { Content } = await render(event);
        return {
          ...event,
          Content,
        };
      })
    );
  }
} catch (error) {
  console.warn("Error loading 'events' content collection:", error);
}
---

<Layout title="UTMFSA | Events & Recaps" description="Catch up on UTMFSA events, cultural showcases, welcome socials, and annual galas at UTM.">
  <!-- Page Header -->
  <section class="py-16 sm:py-20 bg-bg-subtle border-b border-border-subtle text-center">
    <div class="container max-w-4xl">
      <span class="section-eyebrow">UTMFSA EVENTS & RECAPS</span>
      <h1 class="text-4xl sm:text-6xl font-headline font-bold text-text-main tracking-tight mb-4">
        Events & Stories
      </h1>
      <p class="text-text-muted text-lg sm:text-xl leading-relaxed max-w-2xl mx-auto">
        Explore recaps, photo highlights, and upcoming gatherings organized by the UTM Filipino Students' Association.
      </p>
    </div>
  </section>

  <!-- Blog-Style Event Recaps Grid -->
  <section class="py-16 bg-bg-main">
    <div class="container">
      {eventPostsWithContent && eventPostsWithContent.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {eventPostsWithContent.map((event) => {
            const { Content, data } = event;

            return (
              <article class="rounded-2xl border border-border-subtle bg-bg-card overflow-hidden shadow-xs flex flex-col justify-between hover:shadow-md transition-shadow">
                <div>
                  <!-- Featured Image -->
                  <div class="aspect-16/9 w-full overflow-hidden bg-bg-subtle relative border-b border-border-subtle flex items-center justify-center">
                    {data.featuredImage ? (
                      <img
                        src={data.featuredImage}
                        alt={data.title}
                        class="h-full w-full object-cover"
                      />
                    ) : (
                      <div class="h-full w-full bg-primary-light flex items-center justify-center text-primary font-bold text-sm p-4 text-center">
                        {data.title}
                      </div>
                    )}
                    <span class="absolute top-3 left-3 px-3 py-1 bg-primary text-text-inverse text-xs font-bold rounded-full shadow-sm">
                      {data.tag}
                    </span>
                  </div>

                  <!-- Event Details -->
                  <div class="p-6">
                    <div class="flex items-center gap-3 text-xs text-text-muted mb-2 font-medium">
                      <span>{data.date}</span>
                      <span>•</span>
                      <span>{data.location}</span>
                    </div>

                    <h2 class="text-xl font-headline font-bold text-text-main mb-3 leading-snug">
                      {data.title}
                    </h2>

                    <p class="text-text-muted text-sm leading-relaxed mb-4">
                      {data.summary}
                    </p>

                    <div class="prose prose-sm text-text-muted text-xs border-t border-border-subtle pt-3">
                      <Content />
                    </div>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-12 text-text-muted text-sm">
          No events found.
        </div>
      )}
    </div>
  </section>
</Layout>
