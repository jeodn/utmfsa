---
import Layout from "../layouts/Layout.astro";
import MembershipCard3D from "../components/MembershipCard3D.astro";
import SponsorDealsBreakdown from "../components/SponsorDealsBreakdown.astro";
import SponsorRibbon from "../components/SponsorRibbon.astro";
---

<Layout title="UTMFSA | Member's Card" description="Unlock exclusive discounts across Mississauga food, drinks, and entertainment with the official UTMFSA Member Card.">

  <!-- Interactive 3D Card Display -->
  <div id="membership-card">
    <MembershipCard3D />
  </div>

  <!-- Sponsor & Benefits Breakdown Component -->
  <SponsorDealsBreakdown />

  <!-- Continuous Sponsor Ribbon -->
  <SponsorRibbon />
</Layout>
