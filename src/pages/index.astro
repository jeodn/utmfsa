---
import Layout from "../layouts/Layout.astro";
import HeroSplash from "../components/HeroSplash.astro";
import Hero from "../components/Hero.astro";
import SponsorRibbon from "../components/SponsorRibbon.astro";
import MembershipCard3D from "../components/MembershipCard3D.astro";
import AboutSection from "../components/AboutSection.astro";
---

<Layout title="UTMFSA | UTM Filipino Students' Association" transparentHeader={true}>
  <!-- Full Screen Hero Mini Splash -->
  <HeroSplash 
    slogan="Your Community On Campus" 
    subheading="Welcome to UTMFSA!"
  />

  <!-- Main Hero Content Section (Follows Full Screen Splash on Scroll) -->
  <div id="hero-content" class="scroll-mt-16">
    <Hero />
  </div>

  <!-- Apple-Style 3D Scroll-Rotating Membership Card Section -->
  <div id="membership">
    <MembershipCard3D />
  </div>

  <!-- Sponsor Ribbon Marquee -->
  <div id="sponsors">
    <SponsorRibbon slogan="SPONSORS & PARTNERS" />
  </div>
</Layout>
