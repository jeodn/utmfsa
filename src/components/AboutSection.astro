---
import Icon from "./Icon.astro";
---

<section id="about" class="section border-t border-border-subtle bg-bg-subtle text-text-main py-16 sm:py-24">
  <div class="container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Text content with Drop Cap editorial style -->
      <div class="lg:col-span-7 space-y-6 text-left">
        <span class="section-eyebrow">MABUHAY & WELCOME</span>
        <h2 class="text-3xl sm:text-5xl font-headline font-bold text-text-main leading-tight">
          The Heart of Filipino Student Life at UTM
        </h2>
        <div class="about-prose text-text-muted text-base sm:text-lg space-y-4 leading-relaxed">
          <p class="first-letter:font-headline first-letter:text-5xl first-letter:font-bold first-letter:text-primary first-letter:float-left first-letter:mr-3 first-letter:lh-none">
            The University of Toronto Mississauga Filipino Students' Association (UTMFSA) is dedicated to building an inclusive, home-away-from-home community for all students. We bring together Filipino culture, heritage, and friendship across campus.
          </p>
          <p>
            Whether you are eager to taste home-cooked traditional food, participate in our annual flagship <em>Bayanihan Culture Showcase</em>, compete in intramural sports leagues, or enjoy exclusive discounts from local Mississauga business sponsors, UTMFSA is your family.
          </p>
        </div>

        <div class="pt-4 flex flex-wrap gap-4">
          <a href="#membership" class="btn-primary text-base px-7 py-3">
            <span>Get VIP Membership Card</span>
            <Icon name="arrowRight" size={18} />
          </a>
        </div>
      </div>

      <!-- Feature Highlight Cards -->
      <div class="lg:col-span-5 space-y-4">
        <div class="p-6 rounded-2xl bg-bg-card border border-border-subtle shadow-xs flex items-start gap-4 transition-all hover:-translate-y-0.5 hover:shadow-md hover:border-primary-hover">
          <div class="p-3 rounded-xl bg-primary-light text-primary shrink-0">
            <Icon name="sun" size={28} />
          </div>
          <div>
            <h3 class="font-headline font-bold text-text-main text-lg mb-1">Culture & Heritage</h3>
            <p class="text-sm text-text-muted leading-relaxed">Celebrating Filipino music, traditional dance, history, and home-cooked culinary treats.</p>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-bg-card border border-border-subtle shadow-xs flex items-start gap-4 transition-all hover:-translate-y-0.5 hover:shadow-md hover:border-primary-hover">
          <div class="p-3 rounded-xl bg-primary-light text-primary shrink-0">
            <Icon name="users" size={28} />
          </div>
          <div>
            <h3 class="font-headline font-bold text-text-main text-lg mb-1">Community Socials</h3>
            <p class="text-sm text-text-muted leading-relaxed">Building lifelong friendships through halo-halo mixers, sports games, and study jams.</p>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-bg-card border border-border-subtle shadow-xs flex items-start gap-4 transition-all hover:-translate-y-0.5 hover:shadow-md hover:border-primary-hover">
          <div class="p-3 rounded-xl bg-primary-light text-primary shrink-0">
            <Icon name="shoppingBag" size={28} />
          </div>
          <div>
            <h3 class="font-headline font-bold text-text-main text-lg mb-1">Exclusive Sponsor Perks</h3>
            <p class="text-sm text-text-muted leading-relaxed">Discounts at top boba shops, GTA Filipino bakeries, and Asian food spots.</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
