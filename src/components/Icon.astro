const inner = PATHS[name] ?? PATHS.sparkles;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={`inline-block shrink-0 ${className}`}
  aria-hidden="true"
  set:html={inner}
/>
