---
import Icon from "./Icon.astro";
import tertiaryImage from "../assets/images/karaoke2.JPG";
---

<section
  class="hero-tertiary-section relative flex min-h-[75vh] flex-col items-center justify-center text-center px-6 py-20 sm:py-28 bg-bg-main text-text-main overflow-hidden border-t border-border-subtle/50"
>
  <!-- Soft Radial Gradient Background -->
  <div
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-secondary-light/40 via-bg-subtle/20 to-bg-main pointer-events-none"
  >
  </div>

  <div
    class="container relative z-10 max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center"
  >
    <!-- Left Column: Text Content -->
    <div class="lg:col-span-7 flex flex-col items-start text-left gap-6">
      <!-- Eyebrow -->
      <span class="section-eyebrow">Community Events</span>

      <!-- Headline -->
      <h2
        class="text-4xl sm:text-6xl font-headline font-bold tracking-tight text-text-main leading-tight"
      >
        Plus, the Best
        <span> Social Events. </span>
      </h2>

      <!-- Subtitle -->
      <p
        class="max-w-2xl text-text-muted text-base sm:text-lg leading-relaxed font-normal"
      >
        We've been doing everything we can to support the on-campus experience.
        Check what we've been cooking up at UTMFSA!
      </p>

      <!-- CTAs -->
      <div class="mt-4 flex flex-wrap items-center justify-start gap-4">
        <a
          href="/events"
          class="btn-primary text-base px-8 py-3.5 shadow-lg shadow-primary/15"
        >
          <span>View Events</span>
          <Icon name="arrowRight" size={18} />
        </a>
      </div>
    </div>

    <!-- Right Column: Image -->
    <div class="lg:col-span-5 flex justify-center w-full">
      <div
        class="relative w-full max-w-md rounded-2xl overflow-hidden shadow-2xl border border-white/20 transform hover:scale-[1.02] transition-transform duration-300"
      >
        <img
          src={tertiaryImage.src}
          alt="UTMFSA Community and Cultural Connection"
          loading="lazy"
          decoding="async"
          class="w-full h-80 sm:h-96 object-cover"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"
        >
        </div>
      </div>
    </div>
  </div>
</section>
