---
import Icon from "./Icon.astro";
import { Image, getImage } from "astro:assets";
import bgImage from "../assets/images/gala.jpg";
import heroSideImage from "../assets/images/feeding.JPG";

const optimizedBg = await getImage({ src: bgImage });
---

<section class="hero-section relative flex min-h-[75vh] flex-col items-center justify-center text-center px-6 py-20 sm:py-28 bg-bg-main text-text-main overflow-hidden">
  <!-- Soft Radial Gradient Background -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-primary-light/60 via-bg-subtle/30 to-bg-main pointer-events-none"></div>

  <div 
    class="absolute inset-0 bg-cover bg-center opacity-20 pointer-events-none"
  ></div>

  <div class="container relative z-10 max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    <!-- Left Column: Text Content -->
    <div class="lg:col-span-7 flex flex-col items-start text-left gap-6">
      <!-- Main Title with Serif Font -->
      <h1 class="text-4xl sm:text-6xl font-headline font-bold tracking-tight text-text-main leading-tight">
        Representing the <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary via-primary-hover to-secondary">
          Community.
        </span>
      </h1>

      <!-- Subtitle -->
      <p class="max-w-2xl text-text-muted text-base sm:text-lg leading-relaxed font-normal">
        Welcome to UTMFSA! Celebrating Filipino culture, student community, flagship events, and exclusive member perks at the University of Toronto Mississauga.
      </p>

      <!-- CTAs -->
      <div class="mt-4 flex flex-wrap items-center justify-start gap-4">
        <a href="/join" class="btn-primary text-base px-8 py-3.5 shadow-lg shadow-primary/15">
          <span>Get Involved</span>
          <Icon name="arrowRight" size={18} />
        </a>
        <a href="/about-us" class="btn-subtle text-base px-8 py-3.5">
          <span>About UTMFSA</span>
        </a>
      </div>
    </div>

    <!-- Right Column: Image next to the title text -->
    <div class="lg:col-span-5 flex justify-center w-full">
      <div class="relative w-full max-w-md rounded-2xl overflow-hidden shadow-2xl border border-white/20 transform hover:scale-[1.02] transition-transform duration-300">
        <Image 
          src={heroSideImage} 
          alt="UTMFSA Community Event" 
          class="w-full h-80 sm:h-96 object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>
      </div>
    </div>
  </div>
</section>

