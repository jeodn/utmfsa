---
import { Icon } from "astro-icon/components";
---

<section class="hero-section relative flex min-h-[85vh] flex-col items-center justify-center text-center px-6 py-20 bg-stone-900 text-white overflow-hidden">
  <!-- Radial Glow Background -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-amber-600/20 via-stone-900 to-stone-950 pointer-events-none"></div>

  <div class="relative z-10 max-w-4xl mx-auto flex flex-col items-center gap-6">
    <!-- Club Badge -->
    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-amber-400/30 bg-amber-400/10 text-amber-300 text-xs font-semibold uppercase tracking-widest">
      <span class="inline-block w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
      <span>UTM Filipino Students' Association</span>
    </div>

    <!-- Main Title with Serif Font -->
    <h1 class="text-5xl sm:text-7xl font-serif font-bold tracking-tight text-white leading-tight">
      Culture. Community. <br />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-amber-400 to-orange-400">
        Connection.
      </span>
    </h1>

    <!-- Subtitle -->
    <p class="max-w-2xl text-stone-300 text-lg sm:text-xl leading-relaxed font-light">
      Welcome to UTMFSA! We bring together Filipino culture, student community, flagship events, and exclusive member perks at the University of Toronto Mississauga.
    </p>

    <!-- CTAs -->
    <div class="mt-4 flex flex-wrap items-center justify-center gap-4">
      <a href="#membership" class="inline-flex items-center gap-2 rounded-full bg-amber-500 px-8 py-3.5 text-base font-bold text-stone-950 transition-all hover:bg-amber-400 hover:shadow-lg hover:shadow-amber-500/25">
        <span>Get Membership</span>
        <Icon name="heroicons:arrow-right" class="h-5 w-5" />
      </a>
      <a href="#events" class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-8 py-3.5 text-base font-semibold text-white transition-all hover:border-white/50 hover:bg-white/10">
        <span>Explore Events</span>
      </a>
    </div>
  </div>
</section>
