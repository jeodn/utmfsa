---
import { siteConfig } from "../config/site.config";
---

<footer class="border-t border-border-subtle bg-text-main text-text-muted py-12">
  <div class="container flex flex-col md:flex-row items-center justify-between gap-8">
    <div class="flex flex-col sm:flex-row items-center gap-3 text-center sm:text-left">
      <img src="/favicon.ico" alt="UTMFSA Logo" class="h-8 w-8 object-contain rounded-md" />
      <div>
        <span class="font-headline font-bold text-white text-lg tracking-tight block">{siteConfig.shortName}</span>
        <span class="text-xs text-slate-400">© 2026 {siteConfig.name}</span>
      </div>
    </div>

    <!-- Quick Footer Links -->
    <div class="flex flex-wrap justify-center items-center gap-6 text-sm text-slate-300 font-medium">
      <a href="/about-us" class="unstyle-link hover:text-white transition-colors">About Us</a>
      <a href="/membership" class="unstyle-link hover:text-white transition-colors">Membership VIP</a>
      <a href="/events" class="unstyle-link hover:text-white transition-colors">Events</a>
      <a href="/join" class="unstyle-link hover:text-white transition-colors">Why Join?</a>
      <a href="/contact-us" class="unstyle-link hover:text-white transition-colors">Contact Us</a>
      <a href={siteConfig.contact.instagramUrl} target="_blank" rel="noreferrer" class="unstyle-link hover:text-white transition-colors">Instagram</a>
    </div>
  </div>
</footer>
