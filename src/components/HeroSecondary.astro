---
import Icon from "./Icon.astro";
import { Image } from "astro:assets";
import cultureImage from "../assets/images/feeding.jpg";
---

<section class="hero-secondary-section relative flex min-h-[75vh] flex-col items-center justify-center text-center px-6 py-20 sm:py-28 bg-bg-subtle text-text-main overflow-hidden border-t border-border-subtle/50">
  <!-- Soft Radial Gradient Background -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_bottom,_var(--tw-gradient-stops))] from-primary-light/50 via-bg-main/30 to-bg-subtle pointer-events-none"></div>

  <div class="container relative z-10 max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    <!-- Left Column: Image next to the title text -->
    <div class="lg:col-span-5 flex justify-center w-full order-2 lg:order-1">
      <div class="relative w-full max-w-md rounded-2xl overflow-hidden shadow-2xl border border-white/20 transform hover:scale-[1.02] transition-transform duration-300">
        <img
          src={cultureImage.src}
          alt="UTMFSA Cultural Showcase and Community Gathering"
          loading="lazy"
          decoding="async"
          class="w-full h-80 sm:h-96 object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>
      </div>
    </div>

    <!-- Right Column: Text Content -->
    <div class="lg:col-span-7 flex flex-col items-start text-left gap-6 order-1 lg:order-2">

      <!-- Main Title with Serif Font -->
      <h2 class="text-4xl sm:text-6xl font-headline font-bold tracking-tight text-text-main leading-tight">
        Another Title Here.
      </h2>

      <!-- Subtitle -->
      <p class="max-w-2xl text-text-muted text-base sm:text-lg leading-relaxed font-normal">
        Welcome to UTMFSA! Celebrating Filipino culture, student community, community events, and exclusive member perks at the University of Toronto Mississauga.
      </p>

      <!-- CTAs -->
      <div class="mt-4 flex flex-wrap items-center justify-start gap-4">
        <a href="/events" class="btn-primary text-base px-8 py-3.5 shadow-lg shadow-primary/15">
          <span>Upcoming Events</span>
          <Icon name="arrowRight" size={18} />
        </a>
        <a href="/membership" class="btn-subtle text-base px-8 py-3.5">
          <span>Member Perks</span>
        </a>
      </div>
    </div>
  </div>
</section>
