<header class="sticky top-0 z-50 w-full border-b border-slate-200 bg-white/95 backdrop-blur-md text-slate-900 shadow-xs">
  <div class="container flex h-16 items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 no-underline text-slate-900 hover:opacity-90 transition-opacity">
      <img src="/favicon.ico" alt="UTMFSA Logo" class="h-8 w-8 object-contain rounded-md" />
      <span class="font-serif font-bold text-xl tracking-tight text-slate-900">UTMFSA</span>
    </a>

    <!-- Nav Links -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-slate-600">
      <a href="#about" class="unstyle-link hover:text-blue-700 transition-colors">About</a>
      <a href="#sponsors" class="unstyle-link hover:text-blue-700 transition-colors">Sponsors</a>
      <a href="#membership" class="unstyle-link hover:text-blue-700 transition-colors">Membership VIP</a>
      <a href="#events" class="unstyle-link hover:text-blue-700 transition-colors">Events</a>
    </nav>

    <!-- Right Join Button -->
    <div class="flex items-center gap-3">
      <a href="#membership" class="btn-primary text-xs px-5 py-2">
        <span>Join Club</span>
      </a>
    </div>
  </div>
</header>
