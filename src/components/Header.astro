<header class="sticky top-0 z-50 w-full border-b border-border-subtle bg-bg-main/95 backdrop-blur-md text-text-main shadow-xs">
  <div class="container flex h-16 items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 no-underline text-text-main hover:opacity-90 transition-opacity">
      <img src="/favicon.ico" alt="UTMFSA Logo" class="h-8 w-8 object-contain rounded-md" />
      <span class="font-headline font-bold text-xl tracking-tight text-text-main">UTMFSA</span>
    </a>

    <!-- Nav Links -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-semibold text-text-muted">
      <a href="/about-us" class="unstyle-link hover:text-primary transition-colors">About</a>
      <a href="/sponsors" class="unstyle-link hover:text-primary transition-colors">Sponsors</a>
      <a href="/membership" class="unstyle-link hover:text-primary transition-colors">Membership VIP</a>
      <a href="/events" class="unstyle-link hover:text-primary transition-colors">Events</a>
    </nav>

    <!-- Right Join Button -->
    <div class="flex items-center gap-3">
      <a href="#membership" class="btn-primary text-xs px-5 py-2">
        <span>Join Club</span>
      </a>
    </div>
  </div>
</header>
