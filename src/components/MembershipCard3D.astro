---
import Icon from "./Icon.astro";
---

<section id="membership" class="section membership-3d-section relative py-20 sm:py-28 bg-white text-slate-900 overflow-hidden border-t border-slate-200">
  <!-- Soft Background Glow -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-blue-50/80 via-white to-white pointer-events-none"></div>

  <div class="container relative z-10 flex flex-col items-center text-center">
    <span class="section-eyebrow">MEMBER EXCLUSIVE</span>

    <h2 class="text-3xl sm:text-5xl font-serif font-bold tracking-tight text-slate-900 mb-4">
      UTMFSA Digital VIP Card
    </h2>
    <p class="max-w-2xl text-slate-600 text-base sm:text-lg mb-12 px-4">
      Unlock 10-15% discounts across Mississauga, early access to flagship events, and VIP perks for all general members.
    </p>

    <!-- 3D Card Viewport -->
    <div class="card-3d-viewport relative w-full max-w-md aspect-[1.586/1] perspective-1000 my-4">
      <div id="membership-card-3d" class="card-3d-wrapper relative w-full h-full rounded-2xl p-6 sm:p-8 shadow-2xl transition-transform ease-out duration-100 flex flex-col justify-between border border-blue-400/30 bg-gradient-to-br from-blue-900 via-slate-900 to-blue-950 text-white overflow-hidden group">

        <!-- Holographic Sheen Overlay -->
        <div class="card-sheen absolute inset-0 bg-gradient-to-tr from-transparent via-blue-400/20 to-transparent pointer-events-none transition-opacity duration-300 opacity-60"></div>
        
        <!-- Background Sunburst Glow -->
        <div class="absolute -right-16 -bottom-16 w-64 h-64 bg-red-600/20 rounded-full blur-3xl pointer-events-none"></div>

        <!-- Card Top Header -->
        <div class="relative z-10 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <img src="/favicon.ico" alt="UTMFSA Logo" class="w-9 h-9 rounded-md border border-white/30 shadow-xs bg-white/10 p-0.5 object-contain" />
            <div class="flex flex-col text-left">
              <span class="text-xs uppercase tracking-widest text-blue-200 font-bold">UTM FSA</span>
              <span class="text-[10px] text-slate-300">Filipino Students' Association</span>
            </div>
          </div>
          <span class="px-3.5 py-1 text-[10px] font-bold uppercase tracking-wider rounded-full bg-red-600 text-white shadow-sm">
            2025 - 2026
          </span>
        </div>

        <!-- Card Chip & Emblem -->
        <div class="relative z-10 flex items-center justify-between my-auto pt-4">
          <!-- Metallic Chip -->
          <div class="w-12 h-9 rounded-md bg-gradient-to-tr from-amber-300 via-amber-100 to-amber-400 border border-amber-200/80 shadow-inner relative overflow-hidden flex items-center justify-center">
            <div class="w-full h-px bg-amber-800/40 absolute top-1/3"></div>
            <div class="w-full h-px bg-amber-800/40 absolute bottom-1/3"></div>
            <div class="h-full w-px bg-amber-800/40 absolute left-1/2"></div>
          </div>
          
          <div class="text-right">
            <div class="text-[10px] text-blue-200/70 font-mono tracking-widest uppercase">MEMBER ID</div>
            <div class="text-sm font-mono text-white font-semibold tracking-wider">FSA-2025-0842</div>
          </div>
        </div>

        <!-- Card Bottom Info -->
        <div class="relative z-10 flex items-end justify-between text-left pt-2">
          <div>
            <div class="text-[9px] text-slate-300 uppercase tracking-widest">CARDHOLDER</div>
            <div class="text-base sm:text-lg font-serif font-bold text-white tracking-wide">MABUHAY MEMBER</div>
          </div>
          <div class="text-right">
            <div class="text-[9px] text-slate-300 uppercase tracking-widest">STATUS</div>
            <div class="text-xs font-bold text-amber-300 uppercase tracking-wider">VIP ACTIVE</div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-10">
      <a href="#join" class="btn-primary text-base px-8 py-3.5 shadow-lg shadow-blue-700/20">
        <Icon name="card" size={20} />
        <span>Get Your Digital VIP Card</span>
      </a>
    </div>
  </div>
</section>

<style>
  .perspective-1000 {
    perspective: 1200px;
  }
  .card-3d-wrapper {
    transform-style: preserve-3d;
    transform: rotateX(20deg) rotateY(-12deg) rotateZ(2deg) scale(0.95);
    box-shadow: 0 25px 50px -12px rgba(0, 56, 168, 0.25), 0 15px 30px -15px rgba(0, 0, 0, 0.4);
    will-change: transform;
  }
</style>

<script>
  function setupScrollCard() {
    const card = document.getElementById('membership-card-3d');
    const container = card?.closest('.membership-3d-section');
    if (!card || !container) return;

    function onScroll() {
      if (!card || !container) return;
      const rect = container.getBoundingClientRect();
      const windowHeight = window.innerHeight;
      
      const progress = Math.max(0, Math.min(1, (windowHeight - rect.top) / (windowHeight + rect.height)));
      
      const rotateX = (0.5 - progress) * 40;
      const rotateY = (progress - 0.5) * 30;
      const scale = 0.92 + Math.sin(progress * Math.PI) * 0.12;

      card.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(${scale})`;
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  setupScrollCard();
  document.addEventListener('astro:page-load', setupScrollCard);
</script>
