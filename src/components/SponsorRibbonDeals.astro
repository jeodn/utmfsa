---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";

// Import all sponsor image assets from src/assets/sponsors/ with Astro asset processing
const sponsorImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/sponsors/*.{jpeg,jpg,png,gif,svg,webp}",
  { eager: true }
);

interface Sponsor {
  id: string;
  name: string;
  category: string;
  icon: string;
  discount: string;
  imageFileName?: string;
}

const sponsors: Sponsor[] = [
  { id: "chatime", name: "Chatime UTM", category: "Boba & Teas", discount: "10% Off", icon: "sparkles", imageFileName: "chatime.svg" },
  { id: "manila-bakes", name: "Grotto", category: "Filipino Bakery", discount: "Special Perk", icon: "shoppingBag", imageFileName: "grotto.png" },
  { id: "tagpuan", name: "Tagpuan", category: "Restaurant", discount: "15% Off", icon: "badge", imageFileName: "tagpuan.png" },
  { id: "thirstea", name: "Thirstea", category: "Desserts", discount: "Free Topping", icon: "badge", imageFileName: "thirstea.png" },
  { id: "utmsu", name: "UTM Student Union", category: "Partner", discount: "Campus Sponsor", icon: "users" },
  { id: "trapped", name: "TRAPPED", category: "Entertainment", discount: "10% Off", icon: "badge", imageFileName: "trapped.png" }
];

interface Props {
  slogan?: string;
  minCopies?: number;
}

const {
  slogan = "SPONSORS & DEALS",
  minCopies = 2,
} = Astro.props;
---

<div class="pointer-events-none w-full bg-bg-subtle text-text-main select-none border-y border-border-subtle py-3 overflow-hidden shadow-xs">
  <!-- Mobile Slogan Header -->
  <div class="mx-auto flex w-full items-center justify-center gap-1.5 px-4 pt-1 pb-3 text-center md:hidden border-b border-border-subtle">
    <Icon name="star" size={14} class="text-gold shrink-0" />
    <span class="px-2 text-xs font-bold uppercase tracking-wider text-text-main">{slogan}</span>
    <Icon name="star" size={14} class="text-gold shrink-0" />
  </div>

  <!-- Main Marquee Container -->
  <div class="relative flex h-16 w-full items-center justify-center overflow-hidden">
    <!-- 1. Desktop Left Text Badge -->
    <div class="z-30 hidden items-center justify-center gap-3 bg-bg-subtle border-r border-border-subtle px-6 py-2 text-left md:flex shrink-0 h-full">
      <div class="p-2 rounded-xl bg-primary-light text-primary shrink-0 flex items-center justify-center">
        <Icon name="badge" size={22} />
      </div>
      <span class="w-fit max-w-36 shrink text-xs font-bold uppercase tracking-wider text-primary leading-snug">
        {slogan}
      </span>
    </div>

    <!-- 2. Left Fade Gradient -->
    <div class="z-20 hidden h-full w-24 shrink-0 bg-gradient-to-r from-bg-subtle via-bg-subtle/90 to-transparent md:block pointer-events-none"></div>

    <!-- 3. Marquee Track -->
    <div class="make-marquee w-full overflow-hidden z-10 md:-ml-24" data-min-copies={minCopies}>
      <div class="flex items-center whitespace-nowrap py-1">
        {sponsors.map((sponsor) => {
          const imageKey = sponsor.imageFileName ? `/src/assets/sponsors/${sponsor.imageFileName}` : undefined;
          const imageAsset = imageKey ? sponsorImages[imageKey]?.default : undefined;

          return (
            <div class="sponsor-card inline-flex items-center gap-3.5 rounded-full border border-border-subtle bg-bg-card px-5 py-2 shadow-xs transition-transform hover:scale-[1.02] hover:border-primary-hover mx-3 shrink-0">
              {imageAsset ? (
                <img src={imageAsset.src} alt={sponsor.name} class="h-7 w-auto object-contain shrink-0 max-w-[110px]" />
              ) : (
                <span class="flex h-9 w-9 items-center justify-center rounded-full bg-primary-light text-primary shrink-0 border border-primary/20">
                  <Icon name={sponsor.icon} size={18} />
                </span>
              )}
              <div class="flex flex-col text-left shrink-0">
                <span class="text-sm font-bold text-text-main tracking-tight leading-tight">{sponsor.name}</span>
                <span class="text-xs text-text-muted leading-tight">
                  {sponsor.category} • <strong class="inline-block text-secondary font-semibold px-1.5 py-0.5 rounded bg-secondary-light text-[11px]">{sponsor.discount}</strong>
                </span>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- 4. Right Fade Gradient Overlay -->
    <div class="pointer-events-none absolute right-0 top-0 bottom-0 z-20 w-24 bg-gradient-to-l from-bg-subtle via-bg-subtle/90 to-transparent"></div>
  </div>
</div>

<style is:global>
  .make-marquee {
    overflow: hidden;
  }
  .make-marquee > .marquee-track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: marquee-scroll var(--marquee-duration, 25s) linear infinite;
  }
  .make-marquee > .marquee-track > .marquee-unit {
    display: flex;
    flex-shrink: 0;
  }
  @keyframes marquee-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--marquee-distance, -100%));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .make-marquee > .marquee-track {
      animation: none;
    }
  }
</style>

<script>
  const SPEED = 35;
  const RESIZE_DEBOUNCE = 200;

  type Cleanup = () => void;
  let cleanups: Cleanup[] = [];

  function setupMarquee(container: HTMLElement): Cleanup | null {
    const originalContent = document.createDocumentFragment();
    while (container.firstChild) {
      originalContent.appendChild(container.firstChild);
    }

    const track = document.createElement('div');
    track.className = 'marquee-track';
    container.appendChild(track);

    let resizeTimer: number | undefined;
    let lastUnitWidth = 0;
    let lastViewportWidth = 0;

    const build = () => {
      const viewportWidth = container.getBoundingClientRect().width;
      if (viewportWidth <= 0) return;

      const probe = document.createElement('div');
      probe.className = 'marquee-unit';
      probe.style.visibility = 'hidden';
      probe.style.position = 'absolute';
      probe.style.pointerEvents = 'none';
      probe.appendChild(originalContent.cloneNode(true));
      track.appendChild(probe);
      const unitWidth = probe.getBoundingClientRect().width;
      probe.remove();

      if (unitWidth <= 0) return;

      if (unitWidth === lastUnitWidth && viewportWidth === lastViewportWidth && track.children.length > 0) {
        return;
      }
      lastUnitWidth = unitWidth;
      lastViewportWidth = viewportWidth;

      track.style.animation = 'none';
      track.replaceChildren();

      const firstUnit = document.createElement('div');
      firstUnit.className = 'marquee-unit';
      firstUnit.appendChild(originalContent.cloneNode(true));
      track.appendChild(firstUnit);

      const minCopies = Number(container.dataset.minCopies) || 2;
      const copies = Math.max(minCopies, Math.ceil((viewportWidth + unitWidth) / unitWidth) + 1);
      for (let i = 1; i < copies; i++) {
        const unit = document.createElement('div');
        unit.className = 'marquee-unit';
        unit.appendChild(originalContent.cloneNode(true));
        track.appendChild(unit);
      }

      const duration = unitWidth / SPEED;
      track.style.setProperty('--marquee-distance', `-${unitWidth}px`);
      track.style.setProperty('--marquee-duration', `${duration}s`);
      void track.offsetWidth;
      track.style.animation = '';
    };

    const onResize = () => {
      if (resizeTimer !== undefined) window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(build, RESIZE_DEBOUNCE);
    };

    build();
    window.addEventListener('resize', onResize, { passive: true });

    return () => {
      window.removeEventListener('resize', onResize);
      if (resizeTimer !== undefined) window.clearTimeout(resizeTimer);
    };
  }

  function destroyMarquees() {
    for (const fn of cleanups) fn();
    cleanups = [];
  }

  function initMarquees() {
    document.querySelectorAll<HTMLElement>('.make-marquee').forEach((el) => {
      if (el.querySelector(':scope > .marquee-track')) return;
      const cleanup = setupMarquee(el);
      if (cleanup) cleanups.push(cleanup);
    });
  }

  const scheduleInit = (fn: () => void) => window.requestAnimationFrame(fn);

  scheduleInit(initMarquees);
  document.addEventListener('astro:page-load', () => scheduleInit(initMarquees));
  document.addEventListener('astro:before-swap', destroyMarquees);
</script>
